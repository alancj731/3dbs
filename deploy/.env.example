# Copy to .env on the server (cp .env.example .env) and fill in. .env is never committed.

# Public hostname of this VM. Point a DNS A record at the VM's IP, e.g. api.example.com.
# No domain? Use the free sslip.io name for your IP: 203-0-113-10.sslip.io
API_DOMAIN=api.example.com

# Address of the Angular app on Vercel (scheme + host, no trailing slash). The API only accepts
# browser calls from this origin (CORS).
WEB_ORIGIN=https://mysql-sqlserver-postgres.vercel.app

# Password for sa (SQL Server), root (MySQL) and postgres (Postgres). Never exposed to the internet.
# SQL Server rule: 8+ characters using 3 of: upper case, lower case, digits, symbols.
# Use only letters, digits and ! @ # % ^ * - _ + = . (no quotes, spaces, ; $ or backslashes).
DB_ADMIN_PASSWORD=

# Password for the restricted "practice" login that runs visitors' SQL. Same character rules.
PRACTICE_PASSWORD=

# Optional: max Run/Check requests per visitor per minute (default 60).
# SQL_REQUESTS_PER_MINUTE=60
